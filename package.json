{
    "name": "sc1-keno-pro-max-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "stats": "nodemon --es-module-specifier-resolution=node --watch ./tests ./tests/result-statistic.js",
        "prepare": "husky install"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "d3-array": "3.2.0",
        "lodash": "4.17.21",
        "random-js": "2.1.0",
        "sc-game-base": "5.4.0",
        "sc-instrument": "1.1.1",
        "prom-client": "^11.2.1"
    },
    
    "resolutions": {
        "sc-base-apis": "3.0.2",
        "sc-base-database": "2.3.0"
    },
    "devDependencies": {
        "@babel/preset-env": "7.24.7",
        "@commitlint/cli": "18.6.1",
        "@commitlint/config-conventional": "18.6.3",
        "@types/jest": "29.5.12",
        "babel-jest": "29.7.0",
        "husky": "8.0.3",
        "install": "0.13.0",
        "jest": "29.7.0",
        "jest-extended": "4.0.2",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "2.0.0",
        "nodemon": "^2.0.4"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
